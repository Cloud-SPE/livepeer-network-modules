REGISTRY=tztcloud
TAG=v2.0.0

BROKER_LOG_LEVEL=info
BROKER_LISTEN_PORT=8080
BROKER_METRICS_PORT=9090

# Module-local host-config path mounted into the container.
BROKER_CONFIG=../examples/host-config.example.yaml

# Descriptor sealing key: 32 raw bytes or 64 hex chars, referenced from
# host-config.yaml as `session_store.sealing_key_file`. Required once any
# paid-session capability is declared; leave at /dev/null for the
# paid-job-only example config. Not rotatable in place — records sealed
# under the old key fail closed on read.
BROKER_SEALING_KEY=/dev/null

# Directory containing payment-daemon.sock on the host or from a sibling
# container/volume mount.
PAYMENT_DAEMON_SOCKET_DIR=/var/run/livepeer
