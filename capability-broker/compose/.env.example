REGISTRY=tztcloud
TAG=v2.0.0

BROKER_LOG_LEVEL=info
BROKER_LISTEN_PORT=8080
BROKER_METRICS_PORT=9090
# Runner attach over QUIC (UDP). The WebSocket fallback rides BROKER_LISTEN_PORT.
BROKER_QUIC_PORT=8443

# Bearer for the private admin surface, referenced from host-config.yaml as
# `admin_auth.secret_ref: env://BROKER_ADMIN_TOKEN`. Required to enrol a
# runner (POST /admin/v1/enroll) — and nothing is advertised until a runner
# has attached and passed its offer's certification.
BROKER_ADMIN_TOKEN=

# Module-local host-config path mounted into the container.
BROKER_CONFIG=../examples/host-config.example.yaml

# Sealing key: 32 raw bytes or 64 hex chars, referenced from host-config.yaml
# as `session_store.sealing_key_file` and `credential_store.sealing_key_file`
# (they may be the same file). Required once any paid-session offer is
# declared, and required by the credential store — so in practice, always.
# Not rotatable in place: records sealed under the old key fail closed on
# read. Generate with `openssl rand -hex 32`.
BROKER_SEALING_KEY=/opt/livepeer/broker-seal.key

# Directory containing payment-daemon.sock on the host or from a sibling
# container/volume mount.
PAYMENT_DAEMON_SOCKET_DIR=/var/run/livepeer
