# Shared infrastructure compose env (Postgres / Redis / RustFS, profile-gated).
#
# Copy to .env, edit only what you need, then:
#   docker compose -f infra/compose/docker-compose.yml --env-file infra/compose/.env --profile pg up -d
#
# Nothing here is required: every variable has a default baked into the
# compose file. Uncomment a line only to change it. The default credentials
# are for local development — set real ones before exposing any port.

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# ---- Postgres (profile: pg) ----
# POSTGRES_USER=livepeer
# POSTGRES_PASSWORD=livepeer
# POSTGRES_DB=livepeer
# POSTGRES_PORT=5432

# ---- Redis (profile: redis) ----
# REDIS_PORT=6379

# ---- RustFS (profile: rustfs) ----
# RUSTFS_ROOT_USER=rustfsadmin
# RUSTFS_ROOT_PASSWORD=rustfsadmin
# RUSTFS_API_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
# Bucket rustfs-init creates on first boot.
# RUSTFS_DEFAULT_BUCKET=transcoded
