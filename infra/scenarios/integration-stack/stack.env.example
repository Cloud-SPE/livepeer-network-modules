# Copy to stack.env and edit. Never commit stack.env.

# --- identity -------------------------------------------------------------
# The orchestrator address the broker advertises, and the payee whose
# recipient rand anchors every payment session.
ORCH_ETH_ADDRESS=0x5263e0ce3a97b634d8828ce4337ad0f70b30b077

# --- chain ----------------------------------------------------------------
CHAIN_RPC=https://arb1.arbitrum.io/rpc

# --- keys -----------------------------------------------------------------
# The PAYER mints tickets (this is the gateway side). The PAYEE receives
# and redeems them (the orchestrator side). Both are real keys against
# a real chain: a winning ticket moves real value.
PAYER_KEYSTORE=/home/you/.livepeer/keys/gateway/key.json
PAYER_KEYSTORE_PASSWORD_FILE=/home/you/.livepeer/keys/gateway/key.password
PAYEE_KEYSTORE=/home/you/.livepeer/keys/orch/key.json
PAYEE_KEYSTORE_PASSWORD_FILE=/home/you/.livepeer/keys/orch/key.password

# --- spend limits ---------------------------------------------------------
# The payer refuses to sign beyond these. Set them deliberately: they are
# the only thing standing between a mispriced offering and your deposit.
MAX_PAYMENT_WEI=10000000000000000
MAX_PRICE_PER_UNIT=tokens=10

# --- listen ---------------------------------------------------------------
# 0.0.0.0 makes the broker reachable from the LAN. The paid surface has
# no transport auth of its own: possession of a session credential or a
# broker-minted id is the bar, so do not put this on an untrusted network.
BIND_ADDR=0.0.0.0
PAID_PORT=8411
METRICS_PORT=9412

# Advertised to clients; must be an address they can actually reach.
EXTERNAL_BASE_URL=http://10.0.0.135:8411

# --- admin ----------------------------------------------------------------
# Required for PayeeAdmin.ResetSession (recipient-rand rotation drills).
PAYEE_ADMIN_TOKEN=change-me
