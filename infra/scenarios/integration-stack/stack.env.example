# Copy to stack.env and edit. Never commit stack.env.

# Pin immutable production artifacts. Tags are deliberately insufficient for
# a financial pilot; record the resolved sha256 digests in the evidence log.
PAYMENT_IMAGE=tztcloud/livepeer-payment-daemon@sha256:REPLACE
BROKER_IMAGE=tztcloud/livepeer-capability-broker@sha256:REPLACE
RUNNER_IMAGE=tztcloud/livepeer-conformance@sha256:REPLACE

CHAIN_ID=42161
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com
ORCH_ETH_ADDRESS=0xREPLACE_WITH_PAYEE_ADDRESS

PAYER_KEYSTORE=/absolute/path/to/payer/key.json
PAYER_KEYSTORE_PASSWORD_FILE=/absolute/path/to/payer/key.password
PAYEE_KEYSTORE=/absolute/path/to/payee/key.json
PAYEE_KEYSTORE_PASSWORD_FILE=/absolute/path/to/payee/key.password

# Deliberately artificial DUST price for the generic conformance workload.
# A 131,072-unit maximum authorizes 983,040,000,000 wei. The receiver retains
# its 0.001 ETH redeemable winning face and chooses roughly 1/1000 probability
# for a 1T-wei refill. This is a protocol pilot, not a proposed production
# workload price.
WORK_UNIT=tokens
PRICE_WEI=7500000000
PER_UNITS=1000
MAX_AUTHORIZATION_UNITS=131072
ACCOUNT_FLOAT_WEI=1000000000000
MAX_PAYMENT_WEI=1000000000000
MAX_AUTHORIZATION_WEI=1000000000000
MAX_TICKET_FACE_VALUE_WEI=1100000000000000
# Per single token; PRICE_WEI is quoted per PER_UNITS tokens.
MAX_PRICE_PER_UNIT_WEI=7500000

BIND_ADDR=127.0.0.1
PAID_PORT=8411
METRICS_PORT=9412
PAYEE_METRICS_PORT=9413
EXTERNAL_BASE_URL=https://REPLACE_WITH_LOCKED_BROKER_ORIGIN

BROKER_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
PAYEE_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET

# Never persist approval here. Supply it for one reviewed invocation:
# PILOT_APPROVAL=ARBITRUM_ONE_DUST_APPROVED ./pilot.sh
