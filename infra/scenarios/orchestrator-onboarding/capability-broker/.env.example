# Capability Broker — per-data-center worker entry point.
#
# Copy to .env, fill in the Required section, then bring the stack up with:
#   docker compose \
#     -f infra/scenarios/orchestrator-onboarding/capability-broker/docker-compose.yml \
#     --env-file infra/scenarios/orchestrator-onboarding/capability-broker/.env \
#     up -d
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. The
# payment-daemon uses this list for ticket redemption and fails over
# between entries. The public endpoints below are an example, not a
# recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# Your orchestrator's on-chain address (the cold orch identity, same value
# you set on the Secure Orch host). This is the address tickets are redeemed
# on behalf of — NOT the address that signs the redemption transaction.
ORCH_ADDRESS=0xYOUR_ORCH_ADDRESS

# Bearer for the broker's private admin surface. You need it to enrol a
# runner (POST /admin/v1/enroll) — without a runner nothing is advertised.
# Generate with `openssl rand -hex 32`. Never expose port 8080's /admin/*
# to the internet.
BROKER_ADMIN_TOKEN=

# --- Required only with an ingress overlay (traefik / nginx / nginx-dns01) ---
# Public hostname for this broker. The ingress proxy issues a cert for it.
# MUST match the base_url you listed for this broker in your Orch
# Coordinator's coordinator-config.yaml (without the scheme prefix).
# Cloudflare Tunnel does not use this — the hostname lives in the Zero
# Trust UI for that ingress option.
BROKER_HOST=broker-a.example.com

# --- Required only with docker-compose.nginx-dns01.yml ---
# Cloudflare DNS-01 credentials. The token must have Zone:DNS:Edit on the
# zone hosting BROKER_HOST. Leave blank for every other overlay.
CF_DNS_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0
# The payment-daemon can be pinned independently of the broker.
# PAYMENT_TAG=v2.0.0

# --- payment-daemon hot wallet ---
# The keystore the payment-daemon uses to SIGN ticket-redemption
# transactions: the hot wallet for this broker box. It must hold enough ETH
# to pay redemption gas and have redeem authority on behalf of
# ORCH_ADDRESS. This is a DIFFERENT key from the cold orch keystore on your
# Secure Orch host. Never copy the cold key here.
# PAYMENT_KEYSTORE_FILE=/opt/livepeer/payment-keystore.json
# PAYMENT_KEYSTORE_PASSWORD_FILE=/opt/livepeer/payment-keystore-password
# Keystore password as an env var instead of a file. Leave blank to use the
# file at PAYMENT_KEYSTORE_PASSWORD_FILE.
# LIVEPEER_KEYSTORE_PASSWORD=

# --- gas / redemption tuning ---
# Multiplier applied to the RPC's suggested gas price, in percent.
# GAS_PRICE_MULT_PCT=200
# Gas limit for a redeemWinningTicket transaction.
# REDEEM_GAS=500000

# --- capability-broker config ---
# Host path to the host-config.yaml that defines the OFFERS this broker
# sells. It carries no backend URLs: runners attach outbound and declare
# themselves.
# BROKER_CONFIG=/opt/livepeer/host-config.yaml
# Seals the attach-credential store at rest. Generate once:
#   openssl rand -hex 32 > /opt/livepeer/broker-seal.key
# Back it up: losing it means every host re-enrols.
# BROKER_SEAL_KEY=/opt/livepeer/broker-seal.key

# --- broker listeners ---
# Public broker endpoint — must be reachable by gateways. Put TLS in front.
# The ingress overlays drop this mapping and route through the `ingress`
# network.
# BROKER_PUBLIC_BIND=0.0.0.0
# BROKER_LISTEN_PORT=8080
# Runner attach over QUIC (UDP). Runners behind restrictive egress fall back
# to WebSocket on BROKER_LISTEN_PORT, so this is preferred, not required.
# BROKER_QUIC_PORT=8443
# Metrics — keep private.
# BROKER_METRICS_BIND=127.0.0.1
# BROKER_METRICS_PORT=9090

# --- runtime ---
# BROKER_LOG_LEVEL=info

# --- Traefik overlay (docker-compose.traefik.yml only) ---
# Which Traefik cert resolver to use. Match what's defined in your
# traefik.yml (default in the example: `cloudflare`; `letsencrypt` if you
# switched to HTTP-01).
# TRAEFIK_CERTRESOLVER=cloudflare
