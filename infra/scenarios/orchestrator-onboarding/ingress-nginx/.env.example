# Nginx ingress — env file.
#
# Copy to .env, fill in the Required section, then bring the stack up with:
#   docker network create ingress    # one-time, if not already created
#   docker compose \
#     -f infra/scenarios/orchestrator-onboarding/ingress-nginx/docker-compose.yml \
#     --env-file infra/scenarios/orchestrator-onboarding/ingress-nginx/.env \
#     up -d
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Email Let's Encrypt sends expiry notices to.
ACME_EMAIL=

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# Pin specific releases instead of following latest.
# NGINX_PROXY_TAG=latest
# ACME_COMPANION_TAG=latest

# --- ports ---
# :80 must stay reachable from Let's Encrypt for the HTTP-01 challenge.
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
