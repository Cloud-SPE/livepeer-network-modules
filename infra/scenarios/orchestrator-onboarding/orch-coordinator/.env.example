# Orch Coordinator — public-facing registry host.
#
# Copy to .env, fill in the Required section, then bring the stack up with:
#   docker compose \
#     -f infra/scenarios/orchestrator-onboarding/orch-coordinator/docker-compose.yml \
#     --env-file infra/scenarios/orchestrator-onboarding/orch-coordinator/.env \
#     up -d
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Admin bearer token(s), comma-separated. Used by the operator to push
# signed manifests / mutate fleet state. Generate with: openssl rand -hex 32.
# Treat as a secret.
ORCH_COORDINATOR_ADMIN_TOKENS=

# --- Required only with an ingress overlay (traefik / nginx / nginx-dns01) ---
# Public hostname for this coordinator. The ingress proxy issues a cert for
# it. This is the URL you publish on the AI Service Registry contract.
# Cloudflare Tunnel does not use this — the hostname lives in the Zero
# Trust UI for that ingress option.
COORDINATOR_HOST=coordinator.example.com

# --- Required only with docker-compose.nginx-dns01.yml ---
# Cloudflare DNS-01 credentials. The token must have Zone:DNS:Edit on the
# zone hosting COORDINATOR_HOST. Leave blank for every other overlay.
CF_DNS_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- image ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- config file ---
# Host path to your coordinator config. This file defines your fleet:
# capability brokers, manifest identity, publish settings. Bootstrap by
# copying coordinator-config.example.yaml to this path.
# COORDINATOR_CONFIG=/opt/livepeer/coordinator-config.yaml

# --- listeners / port bindings ---
# Public registry endpoint — must be reachable by gateways. The ingress
# overlays drop this mapping and route through the `ingress` network.
# COORDINATOR_PUBLIC_BIND=0.0.0.0
# COORDINATOR_PUBLIC_PORT=8081
# Admin API — keep private (loopback + SSH tunnel, or behind your VPN).
# With the agent overlay the secure-orch host must reach it over LAN/VPN;
# widen the bind for that, never to the public internet.
# COORDINATOR_ADMIN_BIND=127.0.0.1
# COORDINATOR_LISTEN_PORT=8080
# Prometheus metrics — keep private.
# COORDINATOR_METRICS_BIND=127.0.0.1
# COORDINATOR_METRICS_PORT=9091

# --- runtime ---
# COORDINATOR_LOG_LEVEL=info
# COORDINATOR_LOG_FORMAT=text
# How often the coordinator scrapes each broker's /registry/offerings and
# /registry/health for the roster view.
# COORDINATOR_SCRAPE_INTERVAL=5m

# --- sign-cycle agent (docker-compose.agent.yml only) ---
# Shared agent bearer admitting the secure-orch agent on candidate
# download + signed-manifest upload. Generate with: openssl rand -hex 32.
# Must be the SAME token the secure-orch console mounts via
# --coordinator-token-file. Separate credential from the admin tokens.
# COORDINATOR_AGENT_TOKEN_FILE=/opt/livepeer/agent-token
# Refresh an unchanged candidate's issued_at/expires_at for re-signing once
# its remaining validity drops below this. 0 = manifest-ttl/3. The
# coordinator publishes the effective value in metadata.json and the
# secure-orch agent reads it from there.
# COORDINATOR_RENEWAL_THRESHOLD=0

# --- Traefik overlay (docker-compose.traefik.yml only) ---
# Which Traefik cert resolver to use. Match what's defined in your
# traefik.yml (default in the example: `cloudflare`; `letsencrypt` if you
# switched to HTTP-01).
# TRAEFIK_CERTRESOLVER=cloudflare
