# Pool member agent — runner host, attach-only.
#
# Copy to .env, fill in the Required section, then:
#   docker compose \
#     -f infra/scenarios/orchestrator-onboarding/pool-member-agent/docker-compose.yml \
#     --env-file infra/scenarios/orchestrator-onboarding/pool-member-agent/.env \
#     up -d
# or paste the same variables into Portainer's stack environment editor.

# =============================================================================
# Required
# =============================================================================

# Broker base URL. Runners attach outbound to it; nothing dials back.
LIVEPEER_BROKER_URL=https://eu-central-broker.xode.app

# The host id you enrolled on the broker. Must match exactly.
LIVEPEER_HOST_ID=gpu-eu-central

# The attach credential from the enroll bundle (shown once). Treat as a
# secret; rotate on the broker with POST /admin/v1/credentials/{id}/rotate.
LIVEPEER_ATTACH_CREDENTIAL=lpc_replace-with-the-token-from-enroll

# The runner stack's docker network, so service names below resolve.
# `docker network ls` — a Portainer stack named livepeer-transcode-nvidia
# creates livepeer-transcode-nvidia_runners.
RUNNERS_NETWORK=livepeer-transcode-nvidia_runners

# Runner declarations: one entry per container, JSON array on one line.
# local_id names the container to the broker; url is the runner's base URL
# as reachable from the agent (service name on RUNNERS_NETWORK); devices is
# the GPU UUID(s) backing it, from:
#   nvidia-smi --query-gpu=uuid --format=csv,noheader
# Everything else (paths, transports, extractor, readiness, identity) comes
# from the runner's own GET /.well-known/livepeer-runner.
LIVEPEER_RUNNERS_JSON=[{"local_id":"vod","url":"http://transcode-runner:8080","devices":["GPU-replace"]},{"local_id":"abr","url":"http://abr-runner:8080","devices":["GPU-replace"]},{"local_id":"live","url":"http://live-runner:8080","devices":["GPU-replace"]}]

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# REGISTRY=tztcloud
# TAG=v2.0.0

# Broker QUIC attach address (UDP). Preferred when set; leave unset behind
# Cloudflare or any proxy that does not carry UDP — the WebSocket fallback on
# LIVEPEER_BROKER_URL is used.
# LIVEPEER_BROKER_QUIC_ADDR=eu-central-broker.xode.app:8443

# How often the agent re-reads the runner contracts and re-sends the
# document if it changed.
# LIVEPEER_REFRESH_EVERY=1m
