# Secure Orch — cold-key host.
#
# Copy to .env, fill in the Required section, then bring the stack up with:
#   docker compose \
#     -f infra/scenarios/orchestrator-onboarding/secure-orch-control-plane/docker-compose.yml \
#     --env-file infra/scenarios/orchestrator-onboarding/secure-orch-control-plane/.env \
#     up -d
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. Every chain
# reader on this host (protocol-daemon, service-registry-daemon) uses the
# same list and fails over between entries. The public endpoints below are
# an example, not a recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# Your orchestrator's on-chain address. The keystore at KEYSTORE_FILE must
# hold the private key for this address.
ORCH_ADDRESS=0xYOUR_ORCH_ADDRESS

# Admin bearer token(s) for the console UI / API, comma-separated.
# Generate with: openssl rand -hex 32. Treat as a secret; rotate on
# operator handoff.
SECURE_ORCH_ADMIN_TOKENS=

# --- Required only with docker-compose.agent.yml (sign-cycle agent) ---
# Coordinator admin base URL (candidate pull + signed-manifest push) and
# public base URL (publish confirmation via /.well-known). These point at
# the SEPARATE coordinator host; allowlist them in this host's egress
# firewall.
COORDINATOR_URL=https://coordinator.example.com:8080
COORDINATOR_PUBLIC_URL=https://coordinator.example.com:8081

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# Image registry and tag every service on this host runs. Pin a digest by
# editing the compose file's image: lines; a tag can be moved.
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- chain ---
# Expected chain id; the daemons refuse to boot if the RPC reports another.
# 42161 = Arbitrum One.
# CHAIN_ID=42161
# Livepeer Controller contract. Arbitrum One default; override only for
# forks / testnets.
# CONTROLLER_ADDRESS=0xD8E8328501E9645d16Cf49539efC04f734606ee4
# AI ServiceRegistry contract the resolver reads manifest pointers from.
# AI_SERVICE_REGISTRY_ADDRESS=0x04C0b249740175999E5BF5c9ac1dA92431EF34C5
# Primary ServiceRegistry contract. Empty = resolve it from the Controller.
# SERVICE_REGISTRY_ADDRESS=
# Resolver cache seeding: "chain" walks the active pool each round;
# "overlay-only" disables auto-discovery (strict allowlists).
# DISCOVERY_MODE=chain

# --- keystore paths ---
# Host paths to the cold keystore and its password file. Both
# protocol-daemon and secure-orch-console mount this one pair read-only.
# Convention: /opt/livepeer/.
# KEYSTORE_FILE=/opt/livepeer/keystore.json
# KEYSTORE_PASSWORD_FILE=/opt/livepeer/keystore-password

# --- protocol-daemon ---
# round-init | reward | both. "both" calls initializeRound AND
# rewardWithHint each round; "reward" leaves round-init to someone else.
# PROTOCOL_MODE=both
# Refuse to start when the wallet balance is below this many wei.
# 5e15 ≈ 0.005 ETH (~50 reward calls of headroom).
# MIN_BALANCE_WEI=5000000000000000
# Host port for protocol-daemon's Prometheus listener.
# PROTOCOL_METRICS_PORT=9094

# --- service-registry-daemon ---
# Host port for the resolver's Prometheus listener.
# REGISTRY_METRICS_PORT=9095

# --- secure-orch-console ---
# Container bind for the console. 0.0.0.0 is acceptable ONLY on a host with
# no inbound internet (firewalled / private LAN). Otherwise bind 127.0.0.1
# and reach it over an SSH tunnel.
# SECURE_ORCH_LISTEN=0.0.0.0:8081
# Host port published for the console.
# SECURE_ORCH_PORT=8081

# --- sign-cycle agent (docker-compose.agent.yml only) ---
# Shared agent bearer file. Generate with: openssl rand -hex 32. The SAME
# file must be mounted on the coordinator (--agent-token-file). Separate
# credential from the admin tokens; rotate independently.
# AGENT_TOKEN_FILE=/opt/livepeer/agent-token
# Sign policy — the entire auto-sign trust envelope. Bootstrap by copying
# secure-orch-console/examples/sign-policy.json (phase 1: renewals only).
# Reloaded every cycle; an invalid policy pauses all auto-signing.
# SIGN_POLICY_FILE=/opt/livepeer/sign-policy.json
# Conditional-GET poll cadence (±10% jitter applied).
# AGENT_POLL_INTERVAL=60s
# Outbound webhook for agent alerts (held, forbidden, publish/policy
# failure, rate-limit pause, manifest expiry warning). Wiring an expiry
# alert is a phase-1 requirement — this webhook, a Prometheus rule on
# GET /metrics, or both. Empty = no webhook.
# ALERT_WEBHOOK_URL=

# --- logging ---
# LOG_LEVEL=info
# LOG_FORMAT=json
