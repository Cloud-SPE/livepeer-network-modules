# Pool orchestrator — single-host public/data-plane stack.
#
# Copy to .env, fill in the Required section, then bring the stack up with:
#   ./up.sh   # render and validate broker bootstrap before Compose
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. Every chain
# caller on this host — the payment-daemon receiver for ticket redemption
# and pool-payout-executor for payouts — uses this one list and fails over
# between entries. For the executor it overrides the executor.rpc_urls key
# of its mounted config file. The public endpoints below are an example,
# not a recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# Your orchestrator's on-chain address (the cold orch identity from the
# secure-orch host). Tickets are redeemed on behalf of this address.
ORCH_ADDRESS=0xYOUR_ORCH_ADDRESS

# Admin bearer for pool-controller. The broker uses it for its receipt and
# selection-snapshot calls, and the controller uses it when pushing offers and
# attach credential hashes to the broker in this single-host scenario.
# Generate with: openssl rand -hex 32
POOL_CONTROLLER_ADMIN_TOKEN=

# Public HTTPS origin of this broker's paid listener. Spend authorizations and
# paid-session callbacks bind this route, so it must match the URL delegated in
# the published manifest. Origin only: no path, query, fragment, or userinfo.
BROKER_EXTERNAL_BASE_URL=https://pool.example.com

# Hot delegated settlement key. Generate into a protected directory:
#   docker run --rm --user 0 -v /opt/livepeer:/keys \
#     tztcloud/livepeer-capability-broker:v2.0.0 \
#     settlement-key generate --out /keys/broker-settlement.key
#   sudo chown 65532:65532 /opt/livepeer/broker-settlement.key
#   sudo chmod 0400 /opt/livepeer/broker-settlement.key
# Publish the returned public key through the coordinator's normal cold-sign
# cycle. Never put the cold orchestrator key here.
BROKER_SETTLEMENT_KEY=/opt/livepeer/broker-settlement.key

# AES-256 key sealing broker credentials and session descriptors at rest:
#   openssl rand -hex 32 | sudo tee /opt/livepeer/broker-seal.key >/dev/null
#   sudo chown 65532:65532 /opt/livepeer/broker-seal.key
#   sudo chmod 0400 /opt/livepeer/broker-seal.key
# Losing or replacing it makes persisted state unreadable.
BROKER_SEAL_KEY=/opt/livepeer/broker-seal.key

# Admin bearer token(s) for orch-coordinator, comma-separated.
# Generate with: openssl rand -hex 32
ORCH_COORDINATOR_ADMIN_TOKENS=

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- payment-daemon receiver hot wallet ---
# Signs ticket-redemption transactions. Must hold ETH for gas and have
# redeem authority on behalf of ORCH_ADDRESS. Never the cold orch key.
# PAYMENT_KEYSTORE_FILE=/opt/livepeer/payment-keystore.json
# PAYMENT_KEYSTORE_PASSWORD_FILE=/opt/livepeer/payment-keystore-password
# Multiplier applied to the RPC's suggested gas price, in percent.
# GAS_PRICE_MULT_PCT=200
# Gas limit for a redeemWinningTicket transaction.
# REDEEM_GAS=500000

# --- shared unix sockets ---
# Host directory where protocol-daemon exposes protocol.sock and the
# payment-daemon exposes payment-daemon.sock.
# LIVEPEER_SOCKET_DIR=/var/run/livepeer

# --- pool-controller ---
# POOL_CONTROLLER_CONFIG=../../../pool-controller/examples/pool-controller-config.compose.yaml
# POOL_CONTROLLER_DATA_DIR=./run/pool-controller
# POOL_CONTROLLER_PORT=8083
# POOL_CONTROLLER_METRICS_PORT=9090

# --- capability-broker ---
# Operator-owned static broker bootstrap. ./up.sh renders it atomically from
# this file; pool-controller subsequently pushes only offers and credentials.
# POOL_BROKER_CONFIG=./run/broker-host-config.yaml
# BROKER_LABEL=pool-orch
# Public paid/API listener. Put TLS in front before live traffic.
# BROKER_PUBLIC_BIND=0.0.0.0
# BROKER_LISTEN_PORT=8082
# Runner attach over QUIC (UDP).
# BROKER_WORKER_QUIC_BIND=0.0.0.0
# BROKER_WORKER_QUIC_PORT=8443
# Metrics — keep private.
# BROKER_METRICS_BIND=127.0.0.1
# BROKER_METRICS_PORT=9092
# BROKER_LOG_LEVEL=info

# --- orch-coordinator ---
# COORDINATOR_CONFIG=./coordinator-config.yaml
# COORDINATOR_PUBLIC_PORT=8081
# COORDINATOR_LISTEN_PORT=8080
# COORDINATOR_METRICS_PORT=9091
# COORDINATOR_LOG_LEVEL=info
# COORDINATOR_LOG_FORMAT=text
# Optional, cosmetic: links checklist steps 2-4 to the secure-orch console's
# review timeline. Must be reachable from the operator's browser.
# COORDINATOR_SECURE_ORCH_URL=http://localhost:8082

# --- pool-reconciler ---
# POOL_RECONCILER_CONFIG=../../../pool-reconciler/examples/pool-reconciler-config.compose.yaml
# POOL_RECONCILER_STATE_DIR=./run/pool-reconciler

# --- pool-payout-executor ---
# Config file (controller URL, batching, backoff). Its executor.rpc_urls is
# superseded by CHAIN_RPC_URLS above.
# POOL_PAYOUT_EXECUTOR_CONFIG=../../../pool-payout-executor/examples/pool-payout-executor-config.compose.yaml
# Payout hot wallet. A separate key from the payment receiver wallet.
# The default paths are gitignored smoke-run locations; no keystore ships in
# the repo. Point these at your own wallet files — never fund a smoke key.
# POOL_PAYOUT_EXECUTOR_KEYSTORE_FILE=../../../pool-payout-executor/examples/keystore.json
# POOL_PAYOUT_EXECUTOR_KEYSTORE_PASSWORD_FILE=../../../pool-payout-executor/examples/keystore-password
# POOL_PAYOUT_EXECUTOR_STATE_DIR=./run/pool-payout-executor
# How often the executor claims and reconciles payout intents.
# POOL_PAYOUT_EXECUTOR_INTERVAL_MS=5000

# Admin/metrics stay private; terminate member HTTPS at the proxy to port 8084.
# POOL_CONTROLLER_BIND=127.0.0.1
# POOL_CONTROLLER_MEMBER_BIND=127.0.0.1
# POOL_CONTROLLER_MEMBER_PORT=8084
# POOL_CONTROLLER_METRICS_BIND=127.0.0.1

# COORDINATOR_ADMIN_BIND=127.0.0.1
# COORDINATOR_METRICS_BIND=127.0.0.1
