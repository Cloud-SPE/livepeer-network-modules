REGISTRY=tztcloud
TAG=v1.4.0

COORDINATOR_CONFIG=../examples/coordinator-config.yaml

COORDINATOR_LISTEN_PORT=8080
COORDINATOR_PUBLIC_PORT=8081
COORDINATOR_METRICS_PORT=9091

ORCH_COORDINATOR_ADMIN_TOKENS=

COORDINATOR_LOG_LEVEL=info
COORDINATOR_LOG_FORMAT=text

# --- sign-cycle agent (only used with docker-compose.agent.yml) ---
# Shared bearer admitting the secure-orch agent; same file the console
# mounts via --coordinator-token-file. Generate: openssl rand -hex 32
COORDINATOR_AGENT_TOKEN_FILE=./run/agent-token
# 0 = manifest-ttl/3 (default). Keep aligned with the sign policy's
# renewal_threshold_fraction on the secure-orch host.
COORDINATOR_RENEWAL_THRESHOLD=0
