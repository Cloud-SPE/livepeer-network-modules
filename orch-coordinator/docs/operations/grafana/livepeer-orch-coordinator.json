{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping the livepeer-orch-coordinator",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["livepeer", "orch-coordinator"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0},
      {
        "name": "job",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(orch_coordinator_known_brokers, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "title": "Livepeer Orch Coordinator",
  "uid": "livepeer-orch-coordinator",
  "panels": [
    {"type": "row", "title": "Publish health", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 1, "panels": []},
    {
      "type": "stat", "title": "Known brokers", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}, "id": 2,
      "targets": [{"expr": "max(orch_coordinator_known_brokers{job=~\"$job\"})", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Brokers healthy", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "id": 3,
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "targets": [{"expr": "max(orch_coordinator_brokers_healthy{job=~\"$job\"})", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Published manifest age", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 4, "w": 5, "x": 8, "y": 1}, "id": 4,
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 600}, {"color": "red", "value": 1800}]}}, "overrides": []},
      "targets": [{"expr": "max(orch_coordinator_published_manifest_age_seconds{job=~\"$job\"})", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Published capability tuples", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 4, "w": 4, "x": 13, "y": 1}, "id": 5,
      "targets": [{"expr": "max(orch_coordinator_published_capability_tuples{job=~\"$job\"})", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Pending-publish drift", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 4, "w": 7, "x": 17, "y": 1}, "id": 6,
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}}, "overrides": []},
      "targets": [{"expr": "sum by (kind) (orch_coordinator_candidate_drift_count{job=~\"$job\"})", "legendFormat": "{{kind}}", "refId": "A"}]
    },
    {"type": "row", "title": "Pipeline throughput", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 10, "panels": []},
    {
      "type": "timeseries", "title": "Scrapes by broker/outcome", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6}, "id": 11,
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"expr": "sum by (broker,outcome) (rate(orch_coordinator_scrape_total{job=~\"$job\"}[5m]))", "legendFormat": "{{broker}} {{outcome}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Builds / signs / publishes by outcome", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6}, "id": 12,
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {"expr": "sum by (outcome) (rate(orch_coordinator_candidate_builds_total{job=~\"$job\"}[5m]))", "legendFormat": "build {{outcome}}", "refId": "A"},
        {"expr": "sum by (outcome) (rate(orch_coordinator_signed_uploads_total{job=~\"$job\"}[5m]))", "legendFormat": "sign {{outcome}}", "refId": "B"},
        {"expr": "sum by (outcome) (rate(orch_coordinator_publishes_total{job=~\"$job\"}[5m]))", "legendFormat": "publish {{outcome}}", "refId": "C"}
      ]
    },
    {"type": "row", "title": "Latency", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}, "id": 20, "panels": []},
    {
      "type": "timeseries", "title": "Scrape p99 by broker", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 14}, "id": 21,
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le,broker) (rate(orch_coordinator_scrape_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{broker}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Candidate build p99", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 14}, "id": 22,
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(orch_coordinator_candidate_build_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "p99", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Signed-manifest verify p99", "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 14}, "id": 23,
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(orch_coordinator_signed_verify_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "p99", "refId": "A"}]
    }
  ]
}
