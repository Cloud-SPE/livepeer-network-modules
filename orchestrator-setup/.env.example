SETUP_IMAGE=livepeer-orchestrator-setup:local
INPUT_DIR=/opt/livepeer-setup/input
OUTPUT_DIR=/opt/livepeer-setup/output
DEPLOYMENT_ID=broker-a
ORCHESTRATOR_ADDRESS=0x1111111111111111111111111111111111111111
BROKER_URL=https://broker.example.com
# Private TLS route reachable by the coordinator; must permit /admin/.
BROKER_ADMIN_URL=https://broker-admin.internal.example.com
# reuse requires every material file; neither mode replaces existing keys.
MATERIAL_MODE=create-if-missing
