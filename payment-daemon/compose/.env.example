REGISTRY=tztcloud
TAG=v2.0.0

CHAIN_RPC=https://arb1.arbitrum.io/rpc

# Receiver-side hot wallet / sender-side payer wallet.
PAYMENT_KEYSTORE=./run/keystore.json
PAYMENT_KEYSTORE_PASSWORD_FILE=./run/keystore-password
LIVEPEER_KEYSTORE_PASSWORD=

PAYMENT_DAEMON_SOCKET_DIR=/var/run/livepeer

# --- Sender spend limits (runbook §3.5) ---------------------------------
# REQUIRED in chain mode: the daemon refuses to start without it. The most
# this daemon may authorize for ONE payment. A circuit breaker against
# runaway loops and fat-fingered funding — not a price policy. Size it to
# your largest legitimate single request, with headroom.
# 0.01 ETH.
MAX_PAYMENT_WEI=10000000000000000

# Optional rate ceilings, keyed by work unit — this is what handles
# diverse workloads. Add one entry per workload you route to; a unit you
# omit has no rate policy and keeps only the breaker above. Empty is
# valid. Example for a mixed LLM + video deployment:
#   MAX_PRICE_PER_UNIT=tokens=10,video_seconds=2000000000000000
MAX_PRICE_PER_UNIT=

GAS_PRICE_MULT_PCT=200
REDEEM_GAS=500000

# Docker Compose example defaults.
REDEMPTION_INTERVAL=30s
REDEMPTION_CONFIRMATIONS=4
LIVEPEER_RECEIVER_KEYSTORE_PASSWORD=
RECEIVER_KEYSTORE_PATH=./run/receiver-keystore.json
RECEIVER_KEYSTORE_PASSWORD_FILE=./run/receiver-keystore-password
LIVEPEER_SENDER_KEYSTORE_PASSWORD=
SENDER_KEYSTORE_PATH=./run/sender-keystore.json
SENDER_KEYSTORE_PASSWORD_FILE=./run/sender-keystore-password
SCENARIO_FILE=openai-chat-qwen3-8b.yaml
SIM_FORMAT=text
