# payment-daemon — component-local run-only compose.
#
# Copy to .env, fill in the Required section, then bring up ONE mode:
#   docker compose -f payment-daemon/compose/docker-compose.yml --env-file payment-daemon/compose/.env --profile receiver up -d
#   docker compose -f payment-daemon/compose/docker-compose.yml --env-file payment-daemon/compose/.env --profile sender   up -d
#
# Everything under "Overrides" has a default baked into the compose files.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. The daemon
# fails over between entries. The public endpoints below are an example,
# not a recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# --- Required for --profile sender (runbook §3.5) ---
# The most this daemon may authorize for ONE payment. A circuit breaker
# against runaway loops and fat-fingered funding — not a price policy.
# Size it to your largest legitimate single request, with headroom.
# 0.01 ETH shown. The sender refuses to start without it in chain mode.
MAX_PAYMENT_WEI=10000000000000000

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- wallet (receiver-side hot wallet / sender-side payer wallet) ---
# PAYMENT_KEYSTORE_FILE=./run/keystore.json
# PAYMENT_KEYSTORE_PASSWORD_FILE=./run/keystore-password
# Keystore password as an env var instead of a file. Leave blank to use the
# file at PAYMENT_KEYSTORE_PASSWORD_FILE.
# LIVEPEER_KEYSTORE_PASSWORD=

# --- sockets ---
# Host directory the daemon's unix socket is published into; co-located
# processes (broker, gateway) mount the same directory.
# PAYMENT_DAEMON_SOCKET_DIR=/var/run/livepeer

# --- sender rate ceilings (optional, runbook §3.5) ---
# Per-work-unit price ceilings — what handles diverse workloads. One entry
# per workload you route to; a unit you omit has no rate policy and keeps
# only the MAX_PAYMENT_WEI breaker. Example for a mixed LLM + video
# deployment: tokens=10,video_seconds=2000000000000000
# MAX_PRICE_PER_UNIT=

# --- receiver gas / redemption tuning ---
# Multiplier applied to the RPC's suggested gas price, in percent.
# GAS_PRICE_MULT_PCT=200
# Gas limit for a redeemWinningTicket transaction.
# REDEEM_GAS=500000

# --- docker-compose.scenario.yml only ---
# How often the receiver sweeps winning tickets to chain, and how many
# confirmations it waits for before marking one redeemed.
# REDEMPTION_INTERVAL=30s
# REDEMPTION_CONFIRMATIONS=4
# Separate receiver / sender wallets for the split scenario stack.
# LIVEPEER_RECEIVER_KEYSTORE_PASSWORD=
# RECEIVER_KEYSTORE_FILE=./run/receiver-keystore.json
# RECEIVER_KEYSTORE_PASSWORD_FILE=./run/receiver-keystore-password
# LIVEPEER_SENDER_KEYSTORE_PASSWORD=
# SENDER_KEYSTORE_FILE=./run/sender-keystore.json
# SENDER_KEYSTORE_PASSWORD_FILE=./run/sender-keystore-password
# Scenario YAML under payment-daemon/scenarios/ that payout-sim runs, and
# its output format (text | json).
# SCENARIO_FILE=openai-chat-qwen3-8b.yaml
# SIM_FORMAT=text
