REGISTRY=tztcloud
TAG=v2.0.0

POOL_CONTROLLER_ADMIN_TOKEN=
POOL_CONTROLLER_PORT=8083
POOL_CONTROLLER_METRICS_PORT=9090
POOL_CONTROLLER_CONFIG=../examples/pool-controller-config.compose.yaml
POOL_CONTROLLER_DATA_DIR=./run/data
LIVEPEER_SOCKET_DIR=/var/run/livepeer

# Admin/metrics stay private; terminate member HTTPS at the proxy to port 8084.
# POOL_CONTROLLER_BIND=127.0.0.1
# POOL_CONTROLLER_MEMBER_BIND=127.0.0.1
# POOL_CONTROLLER_MEMBER_PORT=8084
# POOL_CONTROLLER_METRICS_BIND=127.0.0.1
