[
  {
    "name": "ready",
    "type": "readiness"
  },
  {
    "name": "smoke",
    "type": "request",
    "config": {
      "assert": [
        "$.choices[0].message.content",
        {
          "min": 1,
          "path": "$.usage.total_tokens"
        }
      ],
      "body": {
        "max_tokens": 8,
        "messages": [
          {
            "content": "ping",
            "role": "user"
          }
        ],
        "model": "{{identity.openai.model}}"
      },
      "transport": "unary"
    }
  },
  {
    "name": "usage",
    "type": "usage",
    "config": {
      "min_units": 1
    }
  },
  {
    "name": "latency",
    "type": "latency",
    "required": false,
    "config": {
      "measure": "first_byte",
      "p50_max_ms": 4000,
      "samples": 3
    }
  }
]
