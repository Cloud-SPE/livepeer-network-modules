# pool-payout-executor — component-local run-only compose.
#
# Copy to .env, fill in the Required section, then:
#   docker compose -f pool-payout-executor/compose/docker-compose.yml --env-file pool-payout-executor/compose/.env up -d
#
# The Arbitrum RPC list lives in the mounted config file (executor.rpc_urls),
# not in this env. Everything under "Overrides" has a default baked into the
# compose file. Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Admin bearer for pool-controller; the executor claims and reports payout
# intents with it.
POOL_CONTROLLER_ADMIN_TOKEN=

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- config + state ---
# Executor config (controller URL, executor.rpc_urls, batching, backoff).
# POOL_PAYOUT_EXECUTOR_CONFIG=../examples/pool-payout-executor-config.compose.yaml
# Payout hot wallet. The example keystore is for smoke runs only — never
# fund it.
# POOL_PAYOUT_EXECUTOR_KEYSTORE_FILE=../examples/keystore.json
# POOL_PAYOUT_EXECUTOR_KEYSTORE_PASSWORD_FILE=../examples/keystore-password
# POOL_PAYOUT_EXECUTOR_STATE_DIR=./run/data
# How often the executor claims and reconciles payout intents.
# POOL_PAYOUT_EXECUTOR_INTERVAL_MS=5000
