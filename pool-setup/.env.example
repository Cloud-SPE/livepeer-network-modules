# Host paths must exist. Input is read-only; output contains secrets and revisions.
SETUP_IMAGE=tztcloud/livepeer-pool-setup:v2.0.0
OUTPUT_DIR=/opt/livepeer/regional-pool/setup-output
EXISTING_MATERIAL_DIR=/opt/livepeer/regional-pool/material
DEPLOYMENT_ID=regional-pool
REGION=us
BROKER_ROLE=transcode
INCLUDE_REGIONAL_MANAGEMENT=true
INCLUDE_MEMBER_PORTAL=true
INCLUDE_GPU_OWNERSHIP=true
INGRESS_MODE=external
# Required only with INCLUDE_GPU_OWNERSHIP=false.
OWNERSHIP_URL=
IMAGE_REGISTRY=tztcloud
IMAGE_TAG=v2.0.0
# Optional JSON map of all eight component names to repository@sha256 references.
# Omit for registry resolution; set for offline generation.
IMAGE_LOCK_FILE=
POOL_ID=
CONTROLLER_VOLUME=regional-pool-us-controller-data
ORCHESTRATOR_ADDRESS=REPLACE_WITH_PUBLIC_ORCHESTRATOR_ADDRESS
BROKER_URL=https://us-transcode.example.org
BROKER_ADMIN_URL=https://us-transcode-admin.example.org
REGION_MEMBER_URL=https://us-members.example.org
REGION_ADMIN_URL=https://us-management.example.org
PORTAL_URL=https://pool.example.org
# These create ONLY missing material. Use reuse for existing deployments.
POOL_IDENTITY_MODE=create-if-missing
RECEIVER_WALLET_MODE=create-if-missing
PAYOUT_WALLET_MODE=create-if-missing
BROKER_KEYS_MODE=create-if-missing
PORTAL_KEYS_MODE=create-if-missing
RECEIVER_DOMAIN_MODE=create-if-missing
SERVICE_CREDENTIALS_MODE=create-if-missing
OWNERSHIP_TLS_MODE=create-if-missing
CREDENTIAL_DAYS=365
# Relative paths under EXISTING_MATERIAL_DIR; no actual secrets in this file.
RPC_URLS_FILE=rpc-urls
RECEIVER_KEYSTORE_FILE=receiver-keystore.json
RECEIVER_PASSWORD_FILE=receiver-password
PAYOUT_KEYSTORE_FILE=payout-keystore.json
PAYOUT_PASSWORD_FILE=payout-password
RECEIVER_DOMAIN_FILE=receiver-domain-id
SERVICE_CREDENTIALS_DIR=service-credentials
# Optional public-address checks for imported wallets.
RECEIVER_WALLET_ADDRESS=
PAYOUT_WALLET_ADDRESS=
