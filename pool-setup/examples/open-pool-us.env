DEPLOYMENT_ID=open-pool
REGION=us
BROKER_ROLE=transcode
INCLUDE_REGIONAL_MANAGEMENT=true
INCLUDE_MEMBER_PORTAL=true
INCLUDE_GPU_OWNERSHIP=true
INGRESS_MODE=external
IMAGE_REGISTRY=tztcloud
IMAGE_TAG=v2.0.0
IMAGE_LOCK_FILE=
POOL_ID=pool_dcf757805bc80cfdff0e1599d6509454
CONTROLLER_VOLUME=open-pool-us-controller-data
ORCHESTRATOR_ADDRESS=0x5263e0ce3a97b634d8828ce4337ad0f70b30b077
RECEIVER_WALLET_ADDRESS=0x4c55c9491242ae3a78d57838fc7fbc0f78b6413c
PAYOUT_WALLET_ADDRESS=0x67979c263bd0ec104317908b33dd67883d1ef68a
BROKER_URL=https://us-central-broker.open-pool.xyz
BROKER_ADMIN_URL=https://us-central-broker-admin.open-pool.xyz
REGION_MEMBER_URL=https://us-members.open-pool.xyz
REGION_ADMIN_URL=https://us-management.open-pool.xyz
PORTAL_URL=https://pool.open-pool.xyz
POOL_IDENTITY_MODE=reuse
RECEIVER_WALLET_MODE=reuse
PAYOUT_WALLET_MODE=reuse
BROKER_KEYS_MODE=reuse
PORTAL_KEYS_MODE=reuse
RECEIVER_DOMAIN_MODE=reuse
SERVICE_CREDENTIALS_MODE=reuse
OWNERSHIP_TLS_MODE=create-if-missing
CREDENTIAL_DAYS=365
RPC_URLS_FILE=secrets/rpc-urls
