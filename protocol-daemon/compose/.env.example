# protocol-daemon — component-local run-only compose.
#
# Copy to .env, fill in the Required section, then:
#   docker compose -f protocol-daemon/compose/docker-compose.yml --env-file protocol-daemon/compose/.env up -d
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. The daemon's
# multi-RPC failover rotates on transient errors and rate-limits; run at
# least two for production. The public endpoints below are an example, not
# a recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# Orchestrator on-chain transcoder address registered with BondingManager.
# The keystore mounted into the daemon MUST be this address's key: reward /
# transcoder / transferBond / withdrawFees / treasury vote all act on
# msg.sender, so the daemon signs as the orchestrator itself.
ORCH_ADDRESS=0xYOUR_COLD_ORCH_ADDRESS

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- mode ---
# round-init | reward | both. "both" calls initializeRound AND
# rewardWithHint each round; "reward" leaves round-init to someone else.
# PROTOCOL_MODE=both

# --- chain ---
# Expected chain id; the daemon refuses to boot if the RPC reports another.
# 42161 = Arbitrum One.
# CHAIN_ID=42161
# Livepeer Controller contract. Arbitrum One default; override only for
# forks / testnets.
# CONTROLLER_ADDRESS=0xD8E8328501E9645d16Cf49539efC04f734606ee4
# LivepeerGovernor (treasury) contract for proposal voting. Not resolved
# from the Controller; operator-supplied. Empty = treasury voting disabled
# (CastVote / GetTreasuryProposal return Unimplemented).
# PROTOCOL_TREASURY_ADDRESS=

# --- keystore paths ---
# Host paths to the cold keystore and its password file.
# KEYSTORE_FILE=./run/keystore.json
# KEYSTORE_PASSWORD_FILE=./run/keystore-password

# --- wallet preflight ---
# Refuse to start when the wallet balance is below this many wei.
# 5e15 ≈ 0.005 ETH (~50 reward calls of headroom).
# MIN_BALANCE_WEI=5000000000000000

# --- tuning ---
# Random delay before initializeRound. Only useful when several
# protocol-daemons might race for the round-init slot; single orchestrator
# leaves 0. Uncomment the flag in the compose file to use it.
# INIT_JITTER=0s
# Gas limit for all on-chain txs. Uncomment the flag in the compose file
# to use it.
# GAS_LIMIT=1000000

# --- observability ---
# Prometheus /metrics port (container and host). The listener is always on
# in this compose; to disable it, remove the --metrics-listen flag and the
# ports entry from the compose file.
# METRICS_PORT=9094
# Host interface the metrics port is published on.
# PROTOCOL_METRICS_BIND=127.0.0.1

# --- logging ---
# LOG_LEVEL=info
# LOG_FORMAT=json
