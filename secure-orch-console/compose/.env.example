REGISTRY=tztcloud
TAG=v1.4.0

SECURE_ORCH_PORT=8080
AUDIT_ROTATE_SIZE=104857600
SECURE_ORCH_ADMIN_TOKENS=change-me-before-production
PROTOCOL_DAEMON_SOCKET=/var/run/livepeer/protocol.sock

SECURE_ORCH_KEYSTORE=./run/keystore.json
SECURE_ORCH_PASSWORD_FILE=./run/password

# Docker Compose example defaults.
SECURE_ORCH_LISTEN=127.0.0.1:8080
SECURE_ORCH_BIND=127.0.0.1

# --- sign-cycle agent (only used with docker-compose.agent.yml) ---
# Admin + public base URLs of the orch-coordinator host.
COORDINATOR_URL=https://coordinator.example.com:8080
COORDINATOR_PUBLIC_URL=https://coordinator.example.com:8081
# Shared bearer; same file goes to the coordinator's --agent-token-file.
AGENT_TOKEN_FILE=./run/agent-token
# Copy ../examples/sign-policy.json here (phase 1: renewals only).
SIGN_POLICY_FILE=./run/sign-policy.json
AGENT_POLL_INTERVAL=60s
# Optional alert webhook; wiring an expiry alert is a phase-1 requirement
# (this webhook, a Prometheus rule on GET /metrics, or both).
ALERT_WEBHOOK_URL=
