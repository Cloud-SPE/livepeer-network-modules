# secure-orch-console — component-local run-only compose.
#
# Copy to .env, fill in the Required section, then:
#   docker compose -f secure-orch-console/compose/docker-compose.yml --env-file secure-orch-console/compose/.env up -d
# Add -f docker-compose.agent.yml for the plan 0042 sign-cycle agent.
#
# Everything under "Overrides" has a default baked into the compose files.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Admin bearer token(s) for the console UI / API, comma-separated.
# Generate with: openssl rand -hex 32. Treat as a secret.
SECURE_ORCH_ADMIN_TOKENS=

# --- Required only with docker-compose.agent.yml ---
# Admin + public base URLs of the orch-coordinator host.
COORDINATOR_URL=https://coordinator.example.com:8080
COORDINATOR_PUBLIC_URL=https://coordinator.example.com:8081

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- keystore paths ---
# Host paths to the cold keystore and its password file (same pair
# protocol-daemon uses when both run on one host).
# KEYSTORE_FILE=./run/keystore.json
# KEYSTORE_PASSWORD_FILE=./run/password

# --- listeners ---
# Container bind. Keep loopback and reach the UI via
# `ssh -L 8080:127.0.0.1:8080 secure-orch` unless the host is isolated.
# SECURE_ORCH_LISTEN=127.0.0.1:8080
# Host interface and port the console is published on.
# SECURE_ORCH_BIND=127.0.0.1
# SECURE_ORCH_PORT=8080

# --- protocol-daemon ---
# Unix socket the console uses for protocol status reads and the
# orchestrator write actions.
# PROTOCOL_DAEMON_SOCKET=/var/run/livepeer/protocol.sock

# --- audit log ---
# Rotate the JSONL audit log at this many bytes (100 MiB).
# AUDIT_ROTATE_SIZE=104857600

# --- sign-cycle agent (docker-compose.agent.yml only) ---
# Shared bearer; the same file goes to the coordinator's --agent-token-file.
# AGENT_TOKEN_FILE=./run/agent-token
# Copy ../examples/sign-policy.json here (phase 1: renewals only).
# SIGN_POLICY_FILE=./run/sign-policy.json
# Conditional-GET poll cadence (±10% jitter applied).
# AGENT_POLL_INTERVAL=60s
# Optional alert webhook; wiring an expiry alert is a phase-1 requirement
# (this webhook, a Prometheus rule on GET /metrics, or both).
# ALERT_WEBHOOK_URL=
