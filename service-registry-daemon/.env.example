# service-registry-daemon — local publisher-mode compose at the component
# root (compose.yaml). Use compose/ for the resolver deployment shape.
#
# Copy to .env and edit before `docker compose up`. Compose reads .env
# automatically for variable interpolation in compose.yaml.
#
# Everything under "Overrides" has a default baked into compose.yaml.
# Uncomment a line only to change it.

# =============================================================================
# Required
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. The daemon
# fails over between entries. The public endpoints below are an example,
# not a recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- image ---
# Published tags: https://hub.docker.com/r/tztcloud/livepeer-service-registry-daemon/tags
# REGISTRY_IMAGE_TAG=v2.0.0

# --- chain ---
# Expected chain id; the daemon refuses to boot if the RPC reports another.
# CHAIN_ID=42161

# --- publisher ---
# Cold orchestrator identity if it differs from the keystore signing
# address. Uncomment the --orch-address flag in compose.yaml to use it.
# ORCH_ADDRESS=

# --- observability ---
# Prometheus /metrics port. The listener is always on in this compose; to
# disable it, remove the --metrics-listen flag from compose.yaml.
# METRICS_PORT=9091

# --- logging ---
# LOG_LEVEL=info
# LOG_FORMAT=json
