# service-registry-daemon — component-local run-only compose (resolver mode).
#
# Copy to .env, fill in the Required section, then:
#   docker compose -f service-registry-daemon/compose/docker-compose.yml --env-file service-registry-daemon/compose/.env up -d
#
# Everything under "Overrides" has a default baked into the compose file.
# Uncomment a line only to change it.

# =============================================================================
# Required for chain discovery
# =============================================================================

# Comma-separated Arbitrum JSON-RPC endpoints, primary first. The resolver
# fails over between entries. The public endpoints below are an example,
# not a recommendation: put your own provider first.
CHAIN_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum.publicnode.com

# =============================================================================
# Overrides (commented out = default shown)
# =============================================================================

# --- images ---
# REGISTRY=tztcloud
# TAG=v2.0.0

# --- chain ---
# Expected chain ID, checked on every configured discovery RPC endpoint at startup.
# CHAIN_ID=42161
# Livepeer Controller contract. Arbitrum One default.
# CONTROLLER_ADDRESS=0xD8E8328501E9645d16Cf49539efC04f734606ee4
# Primary ServiceRegistry contract. Empty = resolve it from the Controller.
# SERVICE_REGISTRY_ADDRESS=
# AI ServiceRegistry contract the resolver reads manifest pointers from.
# AI_SERVICE_REGISTRY_ADDRESS=0x04C0b249740175999E5BF5c9ac1dA92431EF34C5

# --- resolver ---
# Cache seeding: "chain" walks the active pool each round; "overlay-only"
# reads signed coordinator manifest_url entries or unsigned static pins.
# For overlay-only, CHAIN_RPC_URLS may be empty.
# DISCOVERY_MODE=chain
# How often to poll RoundsManager.currentRound() for round transitions.
# ROUND_POLL_INTERVAL=15s
# Reuse a fetched manifest for this long before refetching.
# CACHE_MANIFEST_TTL=5m
# Reject manifests larger than this many bytes.
# MANIFEST_MAX_BYTES=1048576
# Per-fetch HTTP timeout.
# MANIFEST_FETCH_TIMEOUT=5s
# Maximum age for reuse after refresh failure; underlying errors surface past it.
# MAX_STALE=30m
# Refuse unsigned static/CSV nodes unless explicitly allowed by overlay.
# Signed coordinator envelopes always require signature verification.
# REJECT_UNSIGNED=true
# Path (inside the container) to a static overlay file. Empty = none.
# STATIC_OVERLAY=
# For overlay-only: set STATIC_OVERLAY=/etc/livepeer/nodes.yaml and provide
# your coordinator-list YAML via this read-only host bind.
# STATIC_OVERLAY_HOST_PATH=../registry.example.yaml

# --- observability ---
# Prometheus /metrics port (container and host). The listener is always on
# in this compose; to disable it, remove the --metrics-listen flag and the
# ports entry from the compose file.
# METRICS_PORT=9095
# Host interface the metrics port is published on.
# REGISTRY_METRICS_BIND=127.0.0.1

# --- logging ---
# LOG_LEVEL=info
# LOG_FORMAT=json
